{
  "name": "jobflow",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first job application pipeline manager for campus recruiting.",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron tests scripts electron.vite.config.ts vitest.config.ts drizzle.config.ts --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "electron-vite preview",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "drizzle-orm": "1.0.0-rc.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "6.30.1"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "22.18.6",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "1.0.0-rc.4",
    "electron": "38.1.0",
    "electron-vite": "4.0.0",
    "eslint": "9.36.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.4.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
